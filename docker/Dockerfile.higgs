# syntax=docker/dockerfile:1.7
#
# Higgs TTS inference image for this fork.
#
# Differs from ../docker/Dockerfile in one deliberate way: upstream ships a
# dependency-only image and clones sgl-project/sglang-omni@main at container
# start, which would run UPSTREAM code, not this fork. Here the checkout is
# baked in, so a container runs exactly the commit it was built from with no
# network access and no clone at start-up.
#
# Layer order matters: dependencies resolve from pyproject.toml alone, so
# editing source only rebuilds the final COPY + install layers.
#
# Model weights are NOT baked in (a 4B checkpoint would dominate the image).
# Mount them and point the config at the mount, e.g.
#   docker run --gpus all -v /data/higgs-audio-v3-tts-4b:/models/higgs:ro ...

ARG SGLANG_IMAGE=lmsysorg/sglang@sha256:9e148f5ac788e856a06166bd6347a831831eb9fcfab4d1770874823a7c29a1a1
ARG FLASHINFER_CACHE_IMAGE=hongccc/sglang-omni@sha256:02a85f00438c901c72a2eb2ef738974a807f63af3d13084445604f3344067b19

FROM ${FLASHINFER_CACHE_IMAGE} AS flashinfer-cache
FROM ${SGLANG_IMAGE} AS runtime

ARG UCX_COMMIT=d8e50df6651b9ea5b76f23aee0aefbf053a4137a

RUN git clone --filter=blob:none https://github.com/openucx/ucx.git /tmp/ucx \
    && git -C /tmp/ucx checkout "${UCX_COMMIT}" \
    && cd /tmp/ucx \
    && ./autogen.sh \
    && ./contrib/configure-release-mt \
        --enable-shared \
        --disable-static \
        --disable-doxygen-doc \
        --enable-optimizations \
        --enable-cma \
        --enable-devel-headers \
        --with-cuda=/usr/local/cuda \
        --with-verbs \
        --with-dm \
        --prefix=/usr/local \
    && make -j"$(nproc)" \
    && make install-strip \
    && ldconfig \
    && rm -rf /tmp/ucx

# Dependencies only — keyed on pyproject.toml so source edits do not bust it.
# pyworld (reference-space voice fusion) is declared there and installs here.
COPY pyproject.toml /tmp/pyproject.toml
RUN uv pip install --system --break-system-packages --no-build-isolation \
        -r /tmp/pyproject.toml \
    && uv pip install --system --break-system-packages --no-deps --reinstall flashinfer-python==0.6.17 \
    && python3 -m pip uninstall -y flashinfer-cubin flashinfer-jit-cache \
    && rm /tmp/pyproject.toml

# Docker builds do not have a GPU to regenerate architecture-specific JIT
# artifacts. Reuse the Python 3.12 cache validated on Ada (SM89) and Hopper
# (SM90a); other architectures compile into their own cache directory.
COPY --from=flashinfer-cache /root/.cache/flashinfer/0.6.17 /root/.cache/flashinfer/0.6.17

ENV FLASHINFER_WORKSPACE_BASE=/root \
    FLASHINFER_JIT_DEBUG=0

# The fork itself. --no-deps: dependencies are already resolved above, and a
# second resolution could silently upgrade the pinned sglang runtime.
COPY . /workspace/sglang-omni
RUN python3 -m pip install --no-deps --no-build-isolation -e /workspace/sglang-omni

# Provenance: which commit this image actually contains.
ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
ARG BUILD_TIME=unknown
LABEL org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.version="${GIT_BRANCH}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      org.opencontainers.image.source="https://github.com/LingXuanYin/sglang-omni" \
      org.opencontainers.image.title="sglang-omni (higgs-tts fork)"
ENV SGLANG_OMNI_GIT_COMMIT="${GIT_COMMIT}" \
    SGLANG_OMNI_GIT_BRANCH="${GIT_BRANCH}"

WORKDIR /workspace/sglang-omni
ENTRYPOINT ["/opt/nvidia/nvidia_entrypoint.sh"]
CMD ["/bin/zsh"]
